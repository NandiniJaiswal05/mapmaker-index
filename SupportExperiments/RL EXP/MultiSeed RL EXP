import numpy as np
import torch
import gymnasium as gym # Changed from gym to gymnasium
from stable_baselines3 import PPO
from sklearn.feature_selection import mutual_info_regression

def compute_mi(X, Y, D=None):
    """Computes conditional MI with D or unconditional if D is None."""
    # Ensure X, Y are 1D for binning
    bins = 5
    # If X or Y are multi-dimensional, take the first dimension as done in previous solutions.
    # The mutual_info_regression expects 2D array for X and 1D for Y.
    # Here X and Y are passed as 1D arrays, which get reshaped inside compute_mi
    X_b = np.digitize(X.reshape(-1), np.linspace(X.min(), X.max(), bins))
    Y_b = np.digitize(Y.reshape(-1), np.linspace(Y.min(), Y.max(), bins))

    if D is None:
        return mutual_info_regression(X_b.reshape(-1, 1), Y_b, random_state=42)[0]

    # Conditional logic
    mi_vals = []
    for d_val in np.unique(D):
        mask = (D == d_val)
        if np.sum(mask) > 10: # Ensure enough samples for MI estimation
            # X_b[mask] is 1D, reshape to (N, 1) for mutual_info_regression
            mi_vals.append(mutual_info_regression(X_b[mask].reshape(-1, 1), Y_b[mask], random_state=42)[0])
    return np.mean(mi_vals) if mi_vals else 0

def run_trial(seed):
    env = gym.make("LunarLander-v3") # Changed to LunarLander-v3
    # env.seed(seed) # Deprecated in gymnasium, stable_baselines3 handles seeding internally
    model = PPO("MlpPolicy", env, verbose=0).learn(total_timesteps=10000) # Increased training timesteps

    obs, _ = env.reset() # Unpack observation and info
    states, next_states, rewards = [], [], []
    for _ in range(2000): # Increased data collection steps
        action, _ = model.predict(obs)
        next_obs, reward, terminated, truncated, _ = env.step(action) # Unpack all 5 values
        done = terminated or truncated # Combine terminated and truncated for done status

        h_prev = model.policy.mlp_extractor.policy_net(torch.FloatTensor(obs)).detach().numpy()
        h_next = model.policy.mlp_extractor.policy_net(torch.FloatTensor(next_obs)).detach().numpy()
        states.append(h_prev); next_states.append(h_next); rewards.append(reward) # Append entire vectors
        obs = next_obs if not done else env.reset()[0] # Reset returns (observation, info), take observation

    S, Sn, R = np.array(states), np.array(next_states), np.array(rewards)
    # S and Sn are now 2D arrays (num_samples, hidden_dim)
    # Select the first dimension for MI calculation, reshape to (N, 1) if needed for X
    i_int = compute_mi(S[:, 0], Sn[:, 0])
    i_int_c = compute_mi(S[:, 0], Sn[:, 0], D=R)
    # S[:, 0:1] extracts the first column as a 2D array (N, 1), which is correct for X in mutual_info_regression
    i_ext = mutual_info_regression(S[:, 0:1], R, random_state=42)[0]
    return i_int_c / (i_int_c + i_ext) if (i_int_c + i_ext) != 0 else 0 # Prevent division by zero if i_int_c and i_ext are both 0

# ── Run 10 Trials ──
seeds = [1024 + i for i in range(10)]
results = [run_trial(s) for s in seeds]

print(f"Mean MI_cond: {np.mean(results):.4f}")
print(f"Std Deviation: {np.std(results):.4f}")
